{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "rl-content-commerce",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "61401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://hfqqqetcjbkptipqhskx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_UBPXMQMjhyoRYZaC09hiVQ_IATX2d2-",
    "GEMMA_MODEL": "gemma-4-26b-a4b-it",
    "QDRANT_COLLECTION": "content_commerce_bge_m3_v1",
    "LLM_PROVIDER": "claude",
    "CLAUDE_MODEL": "claude-haiku-4-5-20251001",
    "AI_CALLS_ENABLED": "true"
  },
  "observability": {
    "enabled": false
  },
  "keep_vars": true
}
